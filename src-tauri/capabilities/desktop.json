{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "desktop",
    "description": "Desktop capability",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "shell:default",
        "core:window:allow-close",
        "core:window:allow-hide",
        "core:window:allow-minimize",
        "core:window:allow-maximize",
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "run-node",
                    "cmd": "node",
                    "args": [
                        "core/dist/index.js"
                    ]
                }
            ]
        }
    ]
}