{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions. shell:execute/spawn are scoped to `node` only in desktop.json.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "notification:default"
  ]
}
